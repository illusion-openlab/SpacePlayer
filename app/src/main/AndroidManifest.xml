<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <application
        android:name=".platform.SpatialApplication"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_spatial_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_spatial_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.SpacePlayerTheme"
        tools:targetApi="31">

        <activity
            android:name=".platform.LaunchActivity"
            android:exported="true"
            android:theme="@style/Theme.SpacePlayerTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Default WindowContainer configuration.
                 SpacePlayer's default container is a planar main window (library picker),
                 not a Stage — the immersive Stage("ImmersiveStage") is opened on demand from
                 PlaceholderMainScreen via LocalSpatialNavigator.openStage(style = StageStyle.Full),
                 so it needs no static manifest style/immersion configuration here. -->

            <!-- The unique name/id of the default WindowContainer. Required — without it the
                 system cannot bind this Activity's meta-data to the DefaultWindowContainer{}
                 registered in the DSL and falls back to an internal placeholder container,
                 which crashes with "Only support [SUIStage,SUIWindowContainer]". -->
            <meta-data
                android:name="pico.spatial.windowcontainer.id"
                android:value="SpacePlayerMainWindow" />

            <!-- windowcontainer.style: "1" = Planar -->
            <meta-data
                android:name="pico.spatial.windowcontainer.style"
                android:value="1" />

            <meta-data
                android:name="pico.spatial.windowcontainer.defaultsize"
                android:value="1400x860" />

            <!-- resizetype: "2" = ContentMinSize (can grow past the minimum) -->
            <meta-data
                android:name="pico.spatial.windowcontainer.resizetype"
                android:value="2" />

            <!-- worldscaletype: "2" = Fixed (stays at a fixed real-world scale as distance changes) -->
            <meta-data
                android:name="pico.spatial.windowcontainer.worldscaletype"
                android:value="2" />

        </activity>
        <meta-data android:name="icon.3d.list" android:resource="@array/icon_3d_list" />
        <meta-data android:name="icon.sdf.list" android:resource="@array/icon_sdf_list" />
    </application>

</manifest>
